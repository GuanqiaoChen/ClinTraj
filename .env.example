# Never commit credentials or patient text. Existing mixed-case Deepseek_API_KEY works.
MODEL_PROVIDER=local
LOCAL_MODEL_NAME=qwen2.5:3b
# Compose default: http://ollama:11434/v1. Example host vLLM override:
# LOCAL_MODEL_URL=http://host.docker.internal:8001/v1
LOCAL_MODEL_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# Real clinical text additionally requires explicit per-session consent.
ALLOW_EXTERNAL_CLINICAL_DATA=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_THREADS=4
MODEL_TIMEOUT=180
# Proposal role budget in seconds. Three candidates remain available on model timeout.
DECISION_TIMEOUT=30
TRIAGE_TIMEOUT=4
RETRIEVAL_TIMEOUT=8
RERANK_CANDIDATES=12
SPECIALIST_TIMEOUT=5
AUDIT_TIMEOUT=8
# Enabled only for explicitly synthetic research sessions.
SIMULATION_ENABLED=true
SIMULATION_MODEL=qwen2.5:3b
SIMULATION_TIMEOUT=25
RETRIEVAL_PROFILE=bge_m3
RETRIEVAL_SERVICE_URL=http://localhost:8010
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
SPECIALIST_REGISTRY=configs/specialists.yaml
DATABASE_URL=postgresql+psycopg://clintraj:clintraj_local@localhost:55432/clintraj
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=clintraj_local
SOURCE_WORKBOOK=医生审核版.xlsx
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
# Public deployment: set these on the server, not in Git. See docs/deployment.md.
PUBLIC_DOMAIN=clintraj.icu
# CADDY_AUTH_USER=researcher
# CADDY_AUTH_HASH=generated-with-caddy-hash-password
# ALLOWED_ORIGINS=https://clintraj.icu,http://localhost:3000,http://127.0.0.1:3000
