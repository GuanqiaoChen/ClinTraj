# External model clients are not bundled. An application may map these policy values
# into ExternalJSONAdapter only after an explicit governance decision; the library does
# not activate transmission from ambient environment variables alone.
CLINTRAJ_ALLOW_EXTERNAL_MODELS=false
CLINTRAJ_ALLOW_CLINICAL_DATA_TRANSMISSION=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
# Supply provider credentials only in your private environment when implementing a transport.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
CLINTRAJ_LOCAL_MODEL_URL=
